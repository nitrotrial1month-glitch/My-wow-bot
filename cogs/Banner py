import discord
from discord.ext import commands
from discord import app_commands

class Banner(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @commands.hybrid_command(
        name="banner", 
        aliases=["bn"], 
        description="ইউজার বা নিজের প্রোফাইল ব্যানার দেখুন"
    )
    @app_commands.describe(member="যার ব্যানার দেখতে চান তাকে সিলেক্ট করুন")
    async def banner(self, ctx, member: discord.Member = None):
        # যদি কেউ মেনশন না করে তবে নিজের ব্যানার দেখাবে
        member = member or ctx.author
        
        # ইন্টারঅ্যাকশন হলে রেসপন্স টাইম বাড়ানোর জন্য ডিফার করা
        if ctx.interaction:
            await ctx.interaction.response.defer()

        try:
            # ব্যানার ডাটা পাওয়ার জন্য ইউজারকে অবশ্যই fetch_user করতে হয়
            user = await self.bot.fetch_user(member.id)
            
            if not user.banner:
                msg = f"❌ **{member.display_name}**-এর কোনো প্রোফাইল ব্যানার নেই।"
                if ctx.interaction:
                    return await ctx.interaction.followup.send(msg)
                return await ctx.send(msg)

            # এমবেড ডিজাইন
            embed = discord.Embed(
                title=f"🖼️ {member.display_name}'s Banner",
                color=0x2b2d31
            )
            
            # ব্যানারের ইউআরএল সেট করা
            banner_url = user.banner.url
            embed.set_image(url=banner_url)
            
            # ডাউনলোড লিঙ্কগুলো
            embed.description = f"[PNG]({user.banner.with_format('png')}) | [JPG]({user.banner.with_format('jpg')}) | [WebP]({user.banner.with_format('webp')})"
            
            embed.set_footer(
                text=f"Requested by {ctx.author.name}", 
                icon_url=ctx.author.display_avatar.url
            )
            
            if ctx.interaction:
                await ctx.interaction.followup.send(embed=embed)
            else:
                await ctx.send(embed=embed)

        except discord.NotFound:
            await ctx.send("❌ ইউজারকে খুঁজে পাওয়া যায়নি।")
        except Exception as e:
            # এরর মেসেজটি চ্যাটে দেখাবে যাতে আপনি বুঝতে পারেন সমস্যা কী
            await ctx.send(f"❌ একটি সমস্যা হয়েছে: `{e}`")

async def setup(bot):
    await bot.add_cog(Banner(bot))
